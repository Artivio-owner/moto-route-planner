{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Пресеты профиля мотоцикла",
  "type": "object",
  "required": ["presets"],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string" },
    "presets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "tankL",
          "consumptionLPer100Km",
          "speeds",
          "dailyLimitKm",
          "dailyLimitH",
          "heavyDayKm",
          "allowUnpaved"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "tankL": { "type": "number", "minimum": 3, "maximum": 60 },
          "consumptionLPer100Km": { "type": "number", "minimum": 1, "maximum": 20 },
          "speeds": {
            "type": "object",
            "required": ["motorway", "trunk", "regional", "local"],
            "additionalProperties": false,
            "properties": {
              "motorway": { "$ref": "#/definitions/speed" },
              "trunk": { "$ref": "#/definitions/speed" },
              "regional": { "$ref": "#/definitions/speed" },
              "local": { "$ref": "#/definitions/speed" }
            }
          },
          "dailyLimitKm": { "type": "number", "minimum": 50, "maximum": 2000 },
          "dailyLimitH": { "type": "number", "minimum": 1, "maximum": 20 },
          "heavyDayKm": { "type": "number", "minimum": 50, "maximum": 2000 },
          "allowUnpaved": { "type": "boolean" }
        }
      }
    }
  },
  "definitions": {
    "speed": { "type": "number", "minimum": 10, "maximum": 150 }
  }
}
