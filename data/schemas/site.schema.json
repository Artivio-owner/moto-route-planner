{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Сайт: контакты и ссылки",
  "type": "object",
  "required": ["name", "email", "github", "issues", "donate"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "github": {
      "type": "string",
      "format": "uri"
    },
    "issues": {
      "type": "string",
      "format": "uri"
    },
    "donate": {
      "type": "object",
      "required": ["label", "url", "qrImage"],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 0
            },
            {
              "type": "string",
              "pattern": "^https://"
            }
          ]
        },
        "qrImage": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 0
            },
            {
              "type": "string",
              "pattern": "^/media/[^\\s]+\\.(png|jpe?g|svg|webp)$"
            }
          ]
        }
      }
    }
  }
}
