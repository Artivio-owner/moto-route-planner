{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Значения по умолчанию для поездки",
  "type": "object",
  "required": [
    "presetId",
    "people",
    "motorcycles",
    "currency",
    "avoidUnpaved",
    "split",
    "stops",
    "history",
    "longRouteWarningKm"
  ],
  "additionalProperties": false,
  "properties": {
    "note": { "type": "string" },
    "presetId": { "type": "string" },
    "people": { "enum": [1, 2] },
    "motorcycles": { "enum": [1, 2] },
    "currency": { "enum": ["RUB", "USD"] },
    "avoidUnpaved": { "type": "boolean" },
    "split": {
      "type": "object",
      "required": ["mode", "maxKmPerDay"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["km", "manual"] },
        "maxKmPerDay": { "type": "number", "minimum": 50, "maximum": 2000 }
      }
    },
    "stops": {
      "type": "object",
      "required": ["dayStart", "fuelStopMin", "lunchMin", "lunchAfterDrivingH"],
      "additionalProperties": false,
      "properties": {
        "dayStart": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "fuelStopMin": { "type": "number", "minimum": 0, "maximum": 120 },
        "lunchMin": { "type": "number", "minimum": 0, "maximum": 180 },
        "lunchAfterDrivingH": { "type": "number", "minimum": 0, "maximum": 12 }
      }
    },
    "history": {
      "type": "object",
      "required": ["maxEntries", "keepDays"],
      "additionalProperties": false,
      "properties": {
        "maxEntries": { "type": "integer", "minimum": 1, "maximum": 100 },
        "keepDays": { "type": "integer", "minimum": 1, "maximum": 365 }
      }
    },
    "longRouteWarningKm": { "type": "number", "minimum": 100 }
  }
}
